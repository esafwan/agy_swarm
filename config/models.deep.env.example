# agy_swarm_deep model roles. Copy to ~/.config/agy_swarm/models.deep.env (agy_models.sh --deep init).
# Values must be exact strings from `agy models`. Env vars of the same name override this file.
MAIN="Gemini 4 Argon (High)"
PLANNER="Gemini 4 Argon (Medium)"     # plan review gate
EXECUTOR="Gemini 3.8 Flash (Medium)"
EXECUTOR_LIGHT="Gemini 3.8 Flash (Low)"
EXECUTOR_HARD="Gemini 3.8 Flash (High)"
STEERING="Gemini 3.8 Flash (High)"
CROSS_REVIEW="Gemini 4 Argon (Medium)"  # per-node review, verification fan-out
FINAL_REVIEW="Gemini 4 Argon (Medium)"
STUCK_HANDOFF=""                      # optional, e.g. "Claude Opus 5.5 (Low)"; empty = disabled
