# agy_swarm model roles. Copy to ~/.config/agy_swarm/models.env (agy_models.sh init).
# Values must be exact strings from `agy models`. Env vars of the same name override this file.
# agy_swarm defaults never use Argon.
MAIN="Gemini 3.8 Flash (High)"        # orchestrator/coordinator (informational; the calling agent)
PLANNER="GPT-OSS 120B (Medium)"       # plan vetting
EXECUTOR="Gemini 3.8 Flash (Medium)"  # default worker
EXECUTOR_LIGHT="Gemini 3.8 Flash (Low)"
EXECUTOR_HARD="Gemini 3.8 Flash (High)"
STEERING="Gemini 3.8 Flash (High)"
CROSS_REVIEW="GPT-OSS 120B (Medium)"
FINAL_REVIEW="Gemini 3.8 Flash (High)"
STUCK_HANDOFF=""                      # optional, e.g. "Claude Opus 5.5 (Low)"; empty = disabled
